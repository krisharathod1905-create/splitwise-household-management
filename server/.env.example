NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
DB_NAME=queueless
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_change_in_production
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_in_production
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@queueless.app
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=
DOCUMENT_STORAGE_PATH=./private-documents
DOCUMENT_RETENTION_DAYS=90
TOKEN_QR_SECRET=replace-with-a-random-secret-at-least-32-characters
